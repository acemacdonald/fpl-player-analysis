# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Data (raw snapshots and the DuckDB file are regenerated by `fpl refresh`) ---
data/raw/*
!data/raw/.gitkeep
data/*.duckdb
data/*.duckdb.wal

# --- Generated reports stay local: they are per-manager output (you may run several entry ids)
#     and are regenerated from snapshots. Keep the folder, ignore the files.
reports/*.md
!reports/.gitkeep

# --- Cowork workspace memory (personal, never pushed) ---
MEMORY.md

# --- Personal, uncommitted config (e.g. a collaborator's own squad override) ---
config/*.local.toml

# --- OS / editor ---
.DS_Store
.vscode/
*.log

# --- Scratch folder for files this workspace cannot delete (never commit) ---
_to_delete/
